# EchoProof AI — Environment Configuration
# Copy this to .env and modify as needed.

# Model settings
ECHOPROOF_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
ECHOPROOF_DEVICE=cpu
# Optional local checkpoint created by research/train.py. Takes precedence over MODEL_ID.
# ECHOPROOF_CHECKPOINT=E:/absolute/path/to/best_model_eer.pt

# Decision thresholds (UNTUNED defaults)
ECHOPROOF_THRESHOLD_GENUINE=0.35
ECHOPROOF_THRESHOLD_SYNTHETIC=0.65
ECHOPROOF_THRESHOLD_TUNED=false

# CORS
ECHOPROOF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Concurrency
ECHOPROOF_MAX_JOBS=3
